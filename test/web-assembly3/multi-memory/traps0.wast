(module
    (memory $mem0 1)
    (memory $mem1 1)
    (memory $mem2 1)

    (func (export "no_dce.i32.load") (param $i i32) (drop (i32.load $mem1 (local.get $i))))
    (func (export "no_dce.i32.load16_s") (param $i i32) (drop (i32.load16_s $mem1 (local.get $i))))
    (func (export "no_dce.i32.load16_u") (param $i i32) (drop (i32.load16_u $mem1 (local.get $i))))
    (func (export "no_dce.i32.load8_s") (param $i i32) (drop (i32.load8_s $mem1 (local.get $i))))
    (func (export "no_dce.i32.load8_u") (param $i i32) (drop (i32.load8_u $mem1 (local.get $i))))
    (func (export "no_dce.i64.load") (param $i i32) (drop (i64.load $mem1 (local.get $i))))
    (func (export "no_dce.i64.load32_s") (param $i i32) (drop (i64.load32_s $mem1 (local.get $i))))
    (func (export "no_dce.i64.load32_u") (param $i i32) (drop (i64.load32_u $mem2 (local.get $i))))
    (func (export "no_dce.i64.load16_s") (param $i i32) (drop (i64.load16_s $mem2 (local.get $i))))
    (func (export "no_dce.i64.load16_u") (param $i i32) (drop (i64.load16_u $mem2 (local.get $i))))
    (func (export "no_dce.i64.load8_s") (param $i i32) (drop (i64.load8_s $mem2 (local.get $i))))
    (func (export "no_dce.i64.load8_u") (param $i i32) (drop (i64.load8_u $mem2 (local.get $i))))
    (func (export "no_dce.f32.load") (param $i i32) (drop (f32.load $mem2 (local.get $i))))
    (func (export "no_dce.f64.load") (param $i i32) (drop (f64.load $mem2 (local.get $i))))
)

(assert_trap (invoke "no_dce.i32.load" (i32.const 65536)) "out of bounds memory access")
(assert_trap (invoke "no_dce.i32.load16_s" (i32.const 65536)) "out of bounds memory access")
(assert_trap (invoke "no_dce.i32.load16_u" (i32.const 65536)) "out of bounds memory access")
(assert_trap (invoke "no_dce.i32.load8_s" (i32.const 65536)) "out of bounds memory access")
(assert_trap (invoke "no_dce.i32.load8_u" (i32.const 65536)) "out of bounds memory access")
(assert_trap (invoke "no_dce.i64.load" (i32.const 65536)) "out of bounds memory access")
(assert_trap (invoke "no_dce.i64.load32_s" (i32.const 65536)) "out of bounds memory access")
(assert_trap (invoke "no_dce.i64.load32_u" (i32.const 65536)) "out of bounds memory access")
(assert_trap (invoke "no_dce.i64.load16_s" (i32.const 65536)) "out of bounds memory access")
(assert_trap (invoke "no_dce.i64.load16_u" (i32.const 65536)) "out of bounds memory access")
(assert_trap (invoke "no_dce.i64.load8_s" (i32.const 65536)) "out of bounds memory access")
(assert_trap (invoke "no_dce.i64.load8_u" (i32.const 65536)) "out of bounds memory access")
(assert_trap (invoke "no_dce.f32.load" (i32.const 65536)) "out of bounds memory access")
(assert_trap (invoke "no_dce.f64.load" (i32.const 65536)) "out of bounds memory access")

;; Atomic wait/notify use the selected memory, including memory64.
(module
  (memory 1 1 shared)
  (memory 1 1 shared)
  (func (export "wait32") (param i32 i32) (result i32)
    (memory.atomic.wait32 1 offset=8 (local.get 0) (local.get 1) (i64.const 0)))
  (func (export "wait64") (param i32 i64) (result i32)
    (memory.atomic.wait64 1 offset=8 (local.get 0) (local.get 1) (i64.const 0)))
  (func (export "notify") (param i32) (result i32)
    (memory.atomic.notify 1 offset=8 (local.get 0) (i32.const 1)))
)
(assert_return (invoke "wait32" (i32.const 0) (i32.const 0)) (i32.const 2))
(assert_return (invoke "wait32" (i32.const 0) (i32.const 1)) (i32.const 1))
(assert_trap (invoke "wait32" (i32.const 65536) (i32.const 0)) "out of bounds memory access")
(assert_trap (invoke "wait32" (i32.const 1) (i32.const 0)) "unaligned atomic")
(assert_return (invoke "wait64" (i32.const 0) (i64.const 0)) (i32.const 2))
(assert_return (invoke "wait64" (i32.const 0) (i64.const 1)) (i32.const 1))
(assert_trap (invoke "wait64" (i32.const 65536) (i64.const 0)) "out of bounds memory access")
(assert_trap (invoke "wait64" (i32.const 1) (i64.const 0)) "unaligned atomic")
(assert_return (invoke "notify" (i32.const 0)) (i32.const 0))
(assert_trap (invoke "notify" (i32.const 65536)) "out of bounds memory access")
(assert_trap (invoke "notify" (i32.const 1)) "unaligned atomic")

(module
  (memory 1 1)
  (memory 1 1 shared)
  (func (export "wait32") (param i32 i32) (result i32)
    (memory.atomic.wait32 1 offset=8 (local.get 0) (local.get 1) (i64.const 0)))
  (func (export "wait64") (param i32 i64) (result i32)
    (memory.atomic.wait64 1 offset=8 (local.get 0) (local.get 1) (i64.const 0)))
  (func (export "notify") (param i32) (result i32)
    (memory.atomic.notify 1 offset=8 (local.get 0) (i32.const 1)))
)
(assert_return (invoke "wait32" (i32.const 0) (i32.const 0)) (i32.const 2))
(assert_return (invoke "wait32" (i32.const 0) (i32.const 1)) (i32.const 1))
(assert_trap (invoke "wait32" (i32.const 65536) (i32.const 0)) "out of bounds memory access")
(assert_trap (invoke "wait32" (i32.const 1) (i32.const 0)) "unaligned atomic")
(assert_return (invoke "wait64" (i32.const 0) (i64.const 0)) (i32.const 2))
(assert_return (invoke "wait64" (i32.const 0) (i64.const 1)) (i32.const 1))
(assert_trap (invoke "wait64" (i32.const 65536) (i64.const 0)) "out of bounds memory access")
(assert_trap (invoke "wait64" (i32.const 1) (i64.const 0)) "unaligned atomic")
(assert_return (invoke "notify" (i32.const 0)) (i32.const 0))
(assert_trap (invoke "notify" (i32.const 65536)) "out of bounds memory access")
(assert_trap (invoke "notify" (i32.const 1)) "unaligned atomic")

(module
  (memory 1 1 shared)
  (memory 1 1)
  (func (export "wait32") (param i32 i32) (result i32)
    (memory.atomic.wait32 1 offset=8 (local.get 0) (local.get 1) (i64.const 0)))
  (func (export "wait64") (param i32 i64) (result i32)
    (memory.atomic.wait64 1 offset=8 (local.get 0) (local.get 1) (i64.const 0)))
  (func (export "notify") (param i32) (result i32)
    (memory.atomic.notify 1 offset=8 (local.get 0) (i32.const 1)))
)
(assert_trap (invoke "wait32" (i32.const 0) (i32.const 0)) "expected shared memory")
(assert_trap (invoke "wait32" (i32.const 0) (i32.const 1)) "expected shared memory")
(assert_trap (invoke "wait32" (i32.const 65536) (i32.const 0)) "out of bounds memory access")
(assert_trap (invoke "wait32" (i32.const 1) (i32.const 0)) "unaligned atomic")
(assert_trap (invoke "wait64" (i32.const 0) (i64.const 0)) "expected shared memory")
(assert_trap (invoke "wait64" (i32.const 0) (i64.const 1)) "expected shared memory")
(assert_trap (invoke "wait64" (i32.const 65536) (i64.const 0)) "out of bounds memory access")
(assert_trap (invoke "wait64" (i32.const 1) (i64.const 0)) "unaligned atomic")
(assert_return (invoke "notify" (i32.const 0)) (i32.const 0))
(assert_trap (invoke "notify" (i32.const 65536)) "out of bounds memory access")
(assert_trap (invoke "notify" (i32.const 1)) "unaligned atomic")

(module
  (memory 1 1 shared)
  (memory i64 1 1 shared)
  (func (export "wait32") (param i64 i32) (result i32)
    (memory.atomic.wait32 1 offset=8 (local.get 0) (local.get 1) (i64.const 0)))
  (func (export "wait64") (param i64 i64) (result i32)
    (memory.atomic.wait64 1 offset=8 (local.get 0) (local.get 1) (i64.const 0)))
  (func (export "notify") (param i64) (result i32)
    (memory.atomic.notify 1 offset=8 (local.get 0) (i32.const 1)))
)
(assert_return (invoke "wait32" (i64.const 0) (i32.const 0)) (i32.const 2))
(assert_return (invoke "wait32" (i64.const 0) (i32.const 1)) (i32.const 1))
(assert_trap (invoke "wait32" (i64.const 65536) (i32.const 0)) "out of bounds memory access")
(assert_trap (invoke "wait32" (i64.const 1) (i32.const 0)) "unaligned atomic")
(assert_return (invoke "wait64" (i64.const 0) (i64.const 0)) (i32.const 2))
(assert_return (invoke "wait64" (i64.const 0) (i64.const 1)) (i32.const 1))
(assert_trap (invoke "wait64" (i64.const 65536) (i64.const 0)) "out of bounds memory access")
(assert_trap (invoke "wait64" (i64.const 1) (i64.const 0)) "unaligned atomic")
(assert_return (invoke "notify" (i64.const 0)) (i32.const 0))
(assert_trap (invoke "notify" (i64.const 65536)) "out of bounds memory access")
(assert_trap (invoke "notify" (i64.const 1)) "unaligned atomic")

;; The shared wait helper must also preserve the width of memory zero.
(module
  (memory i64 1 1 shared)
  (func (export "init")
    (i64.store (i64.const 8) (i64.const 4294967297)))
  (func (export "wait32") (param i32) (result i32)
    (memory.atomic.wait32 offset=8 (i64.const 0) (local.get 0) (i64.const 0)))
  (func (export "wait64") (param i64) (result i32)
    (memory.atomic.wait64 offset=8 (i64.const 0) (local.get 0) (i64.const 0)))
)
(invoke "init")
(assert_return (invoke "wait32" (i32.const 1)) (i32.const 2))
(assert_return (invoke "wait32" (i32.const 0)) (i32.const 1))
(assert_return (invoke "wait64" (i64.const 4294967297)) (i32.const 2))
(assert_return (invoke "wait64" (i64.const 1)) (i32.const 1))

(module
  (memory 1 1)
  (memory i64 1 1 shared)
  (func (export "wait32") (param i64 i32) (result i32)
    (memory.atomic.wait32 1 offset=8 (local.get 0) (local.get 1) (i64.const 0)))
  (func (export "wait64") (param i64 i64) (result i32)
    (memory.atomic.wait64 1 offset=8 (local.get 0) (local.get 1) (i64.const 0)))
  (func (export "notify") (param i64) (result i32)
    (memory.atomic.notify 1 offset=8 (local.get 0) (i32.const 1)))
)
(assert_return (invoke "wait32" (i64.const 0) (i32.const 0)) (i32.const 2))
(assert_return (invoke "wait32" (i64.const 0) (i32.const 1)) (i32.const 1))
(assert_trap (invoke "wait32" (i64.const 65536) (i32.const 0)) "out of bounds memory access")
(assert_trap (invoke "wait32" (i64.const 1) (i32.const 0)) "unaligned atomic")
(assert_return (invoke "wait64" (i64.const 0) (i64.const 0)) (i32.const 2))
(assert_return (invoke "wait64" (i64.const 0) (i64.const 1)) (i32.const 1))
(assert_trap (invoke "wait64" (i64.const 65536) (i64.const 0)) "out of bounds memory access")
(assert_trap (invoke "wait64" (i64.const 1) (i64.const 0)) "unaligned atomic")
(assert_return (invoke "notify" (i64.const 0)) (i32.const 0))
(assert_trap (invoke "notify" (i64.const 65536)) "out of bounds memory access")
(assert_trap (invoke "notify" (i64.const 1)) "unaligned atomic")

(module
  (memory 1 1 shared)
  (memory i64 1 1)
  (func (export "wait32") (param i64 i32) (result i32)
    (memory.atomic.wait32 1 offset=8 (local.get 0) (local.get 1) (i64.const 0)))
  (func (export "wait64") (param i64 i64) (result i32)
    (memory.atomic.wait64 1 offset=8 (local.get 0) (local.get 1) (i64.const 0)))
  (func (export "notify") (param i64) (result i32)
    (memory.atomic.notify 1 offset=8 (local.get 0) (i32.const 1)))
)
(assert_trap (invoke "wait32" (i64.const 0) (i32.const 0)) "expected shared memory")
(assert_trap (invoke "wait32" (i64.const 0) (i32.const 1)) "expected shared memory")
(assert_trap (invoke "wait32" (i64.const 65536) (i32.const 0)) "out of bounds memory access")
(assert_trap (invoke "wait32" (i64.const 1) (i32.const 0)) "unaligned atomic")
(assert_trap (invoke "wait64" (i64.const 0) (i64.const 0)) "expected shared memory")
(assert_trap (invoke "wait64" (i64.const 0) (i64.const 1)) "expected shared memory")
(assert_trap (invoke "wait64" (i64.const 65536) (i64.const 0)) "out of bounds memory access")
(assert_trap (invoke "wait64" (i64.const 1) (i64.const 0)) "unaligned atomic")
(assert_return (invoke "notify" (i64.const 0)) (i32.const 0))
(assert_trap (invoke "notify" (i64.const 65536)) "out of bounds memory access")
(assert_trap (invoke "notify" (i64.const 1)) "unaligned atomic")
