;; A function may be called through a supertype of its declared type.
(module
    (type $t0 (sub (func (result i32))))
    (type $t1 (sub $t0 (func (result i32))))
    (type $t2 (sub $t1 (func (result i32))))

    (func $f0 (type $t0) (i32.const 10))
    (func $f1 (type $t1) (i32.const 11))
    (func $f2 (type $t2) (i32.const 12))

    (table $t 3 3 funcref)
    (table $t64 i64 3 3 funcref)
    (elem (table $t) (i32.const 0) func $f0 $f1 $f2)
    (elem (table $t64) (i64.const 0) func $f0 $f1 $f2)

    (func (export "call_indirect.t0") (param i32) (result i32)
        (call_indirect $t (type $t0) (local.get 0)))
    (func (export "call_indirect.t1") (param i32) (result i32)
        (call_indirect $t (type $t1) (local.get 0)))
    (func (export "call_indirect.t2") (param i32) (result i32)
        (call_indirect $t (type $t2) (local.get 0)))
    (func (export "call_indirect64.t0") (param i64) (result i32)
        (call_indirect $t64 (type $t0) (local.get 0)))
    (func (export "call_indirect64.t2") (param i64) (result i32)
        (call_indirect $t64 (type $t2) (local.get 0)))

    (func (export "return_call_indirect.t0") (param i32) (result i32)
        (return_call_indirect $t (type $t0) (local.get 0)))
    (func (export "return_call_indirect.t2") (param i32) (result i32)
        (return_call_indirect $t (type $t2) (local.get 0)))
    (func (export "return_call_indirect64.t0") (param i64) (result i32)
        (return_call_indirect $t64 (type $t0) (local.get 0)))
    (func (export "return_call_indirect64.t2") (param i64) (result i32)
        (return_call_indirect $t64 (type $t2) (local.get 0)))

    (func (export "call_ref.t0") (result i32)
        (call_ref $t0 (ref.func $f2)))
    (func (export "call_ref.t1") (result i32)
        (call_ref $t1 (ref.func $f2)))
    (func (export "return_call_ref.t0") (result i32)
        (return_call_ref $t0 (ref.func $f2)))
    (func (export "return_call_ref.t1") (result i32)
        (return_call_ref $t1 (ref.func $f2)))
)

(assert_return (invoke "call_indirect.t0" (i32.const 0)) (i32.const 10))
(assert_return (invoke "call_indirect.t0" (i32.const 1)) (i32.const 11))
(assert_return (invoke "call_indirect.t0" (i32.const 2)) (i32.const 12))
(assert_trap (invoke "call_indirect.t1" (i32.const 0)) "indirect call type mismatch")
(assert_return (invoke "call_indirect.t1" (i32.const 1)) (i32.const 11))
(assert_return (invoke "call_indirect.t1" (i32.const 2)) (i32.const 12))
(assert_trap (invoke "call_indirect.t2" (i32.const 0)) "indirect call type mismatch")
(assert_trap (invoke "call_indirect.t2" (i32.const 1)) "indirect call type mismatch")
(assert_return (invoke "call_indirect.t2" (i32.const 2)) (i32.const 12))

(assert_return (invoke "call_indirect64.t0" (i64.const 0)) (i32.const 10))
(assert_return (invoke "call_indirect64.t0" (i64.const 2)) (i32.const 12))
(assert_trap (invoke "call_indirect64.t2" (i64.const 1)) "indirect call type mismatch")
(assert_return (invoke "call_indirect64.t2" (i64.const 2)) (i32.const 12))

(assert_return (invoke "return_call_indirect.t0" (i32.const 0)) (i32.const 10))
(assert_return (invoke "return_call_indirect.t0" (i32.const 2)) (i32.const 12))
(assert_trap (invoke "return_call_indirect.t2" (i32.const 1)) "indirect call type mismatch")
(assert_return (invoke "return_call_indirect.t2" (i32.const 2)) (i32.const 12))

(assert_return (invoke "return_call_indirect64.t0" (i64.const 0)) (i32.const 10))
(assert_return (invoke "return_call_indirect64.t0" (i64.const 2)) (i32.const 12))
(assert_trap (invoke "return_call_indirect64.t2" (i64.const 1)) "indirect call type mismatch")
(assert_return (invoke "return_call_indirect64.t2" (i64.const 2)) (i32.const 12))

(assert_return (invoke "call_ref.t0") (i32.const 12))
(assert_return (invoke "call_ref.t1") (i32.const 12))
(assert_return (invoke "return_call_ref.t0") (i32.const 12))
(assert_return (invoke "return_call_ref.t1") (i32.const 12))
