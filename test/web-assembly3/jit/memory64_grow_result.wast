;; The result of memory.grow is an i64 when the memory is 64-bit.
(module
    (memory $fixed i64 0 0)
    (memory $growable i64 1 4)
    (memory $scratch 1 1)
    (global $g (mut i64) (i64.const 0))

    (func $second (param i32 i64) (result i64) (local.get 1))

    (func (export "direct") (result i64)
        (memory.grow $fixed (i64.const 1)))
    (func (export "add") (result i64)
        (i64.add (memory.grow $fixed (i64.const 1)) (i64.const 1)))
    (func (export "local.set") (result i64) (local $l i64)
        (local.set $l (memory.grow $fixed (i64.const 1)))
        (local.get $l))
    (func (export "local.tee") (result i64) (local $l i64)
        (i64.add (local.tee $l (memory.grow $fixed (i64.const 1))) (local.get $l)))
    (func (export "global.set") (result i64)
        (global.set $g (memory.grow $fixed (i64.const 1)))
        (global.get $g))
    (func (export "call") (result i64)
        (call $second (i32.const 3) (memory.grow $fixed (i64.const 1))))
    (func (export "store") (result i64)
        (i64.store $scratch (i32.const 0) (memory.grow $fixed (i64.const 1)))
        (i64.load $scratch (i32.const 0)))
    (func (export "if") (param i32) (result i64)
        (if (result i64) (local.get 0)
            (then (i64.const 5))
            (else (memory.grow $fixed (i64.const 1)))))
    (func (export "return") (param i32) (result i64)
        (if (local.get 0) (then (return (memory.grow $fixed (i64.const 1)))))
        (i64.const 4))
    (func (export "fill") (result i64)
        (memory.fill $growable (i64.const 1) (i32.const 0) (memory.grow $fixed (i64.const 0)))
        (memory.size $growable))
    (func (export "grow") (result i64)
        (i64.add (memory.grow $growable (i64.const 1)) (i64.const 0x100000000)))
)

(assert_return (invoke "direct") (i64.const -1))
(assert_return (invoke "add") (i64.const 0))
(assert_return (invoke "local.set") (i64.const -1))
(assert_return (invoke "local.tee") (i64.const -2))
(assert_return (invoke "global.set") (i64.const -1))
(assert_return (invoke "call") (i64.const -1))
(assert_return (invoke "store") (i64.const -1))
(assert_return (invoke "if" (i32.const 0)) (i64.const -1))
(assert_return (invoke "if" (i32.const 1)) (i64.const 5))
(assert_return (invoke "return" (i32.const 1)) (i64.const -1))
(assert_return (invoke "return" (i32.const 0)) (i64.const 4))
(assert_return (invoke "fill") (i64.const 1))
(assert_return (invoke "grow") (i64.const 0x100000001))
