06 \05\1f\06.\05*\06t\05\1c \03\93\7f.\05\0c\06\03\ee\00 \05\01\da\06\03\8e\7f \05\0a\06\03\f1\00 \05\01\f3\02\01\00\01\01\00\05\02\ff\ff\ff\ff\03\f4\00\01\05\11\0a\ad\05\1d\06 \05 \06.\05+\06t\053 \03\8a\7f.\05\11\06\03\f7\00\90\05\1d\06 \05 .\05+t\053\06\1f\06\03\8a\7f.\05\0c\06\03\f8\00 \05\01\03\0a\9e\06\03\fe~ \05\11\03\f6\00t\05\1c\06$\05\1f.\05*\06t\05\1c \03\86\7f.\05\0c\06\03\fb\00 \05\01\c1\06\03\fe~ \05\10\06\03\fd\00t\05\1c\06 \05\1f\06.\05*\06t\05\1c \03\83\7f.\05\0c\06\03\fe\00 \05\01\be\06\03\fe~ \05\0a\06\03\81\01 \05\01\d7\02\01\00\01\01\00\05\02\ff\ff\ff\ff\03\83\01\01\05\0d\0a\91\05\19\06 \05\1c\06.\05$\06t\05\19 \03\fb~.\05\0c\06\03\86\01 \05\01\86\06\03\f6~ \05\0a\06\03\89\01 \05\01\9f\02\01\00\01\01\00\05\02\ff\ff\ff\ff\03\8b\01\01\05\0d\0a\91\05\19\06 \05\1c\06.\05$\06t\05\19 \03\f3~.\05\0c\06\03\8e\01 \05\01\86\06\03\ee~ \05\0a\06\03\91\01 \05\01\9f\02\01\00\01\01G\08\00\00\04\00\83\04\00\00\01\01\01\fb\0e\0d\00\01\01\01\01\00\00\00\01\00\00\01wasisdk://v32.0/src/wasi-libc/libc-bottom-half/cloudlibc/src/libc/dirent\00wasisdk://v32.0/src/wasi-libc/libc-bottom-half/headers/private/wasi\00wasisdk://v32.0/src/wasi-libc/libc-bottom-half/cloudlibc/src/common\00wasisdk://v32.0/build/sysroot/wasi-libc-wasm32-wasip2-build-prefix/src/wasi-libc-wasm32-wasip2-build-build/sysroot/include/wasm32-wasip2/bits\00wasisdk://v32.0/build/sysroot/wasi-libc-wasm32-wasip2-build-prefix/src/wasi-libc-wasm32-wasip2-build-build/sysroot/include/wasm32-wasip2/wasi\00wasisdk://v32.0/build/sysroot/wasi-libc-wasm32-wasip2-build-prefix/src/wasi-libc-wasm32-wasip2-build-build/sysroot/include/wasm32-wasip2\00\00readdir.c\00\01\00\00file_utils.h\00\02\00\00errors.h\00\03\00\00dirent_impl.h\00\01\00\00alltypes.h\00\04\00\00__generated_wasip2.h\00\05\00\00__typedef_ino_t.h\00\06\00\00__struct_dirent.h\00\06\00\00__typedef_DIR.h\00\06\00\00descriptor_table.h\00\02\00\00__typedef_off_t.h\00\06\00\00__typedef_dev_t.h\00\06\00\00__struct_stat.h\00\06\00\00__typedef_nlink_t.h\00\06\00\