  (type $two (func (result i32 i32)))
  (func (export "test") (result i32)
    (block (type $two)
      i32.const 42
      i32.const 43
      br 0
    )
    i32.add
  )
  (func (export "test_drop") (result i32)
    (block (type $two)
      i32.const 1
      i32.const 2
      br 0
    )
    drop
    drop
    i32.const 7
  )
)

(assert_return (invoke "test") (i32.const 85))
(assert_return (invoke "test_drop") (i32.const 7))
