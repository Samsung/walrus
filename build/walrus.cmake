SET (WALRUS_INCDIRS
    ${WALRUS_INCDIRS}
    ${WALRUS_ROOT}/src/
    ${SLJIT_ROOT}/sljit_src/
    ${GCUTIL_ROOT}/include/
)

# Select configuration flags at build time for single- and multi-config generators.
IF (CMAKE_CXX_COMPILER_ID STREQUAL "MSVC" OR COMPILER_CLANG_CL)
    STRING (REPLACE "/O2" "/O1" WALRUS_CXXFLAGS_MINSIZEREL "${WALRUS_CXXFLAGS_RELEASE}")
ELSE()
    STRING (REPLACE "-O2" "-Os" WALRUS_CXXFLAGS_MINSIZEREL "${WALRUS_CXXFLAGS_RELEASE}")
ENDIF()
SET (WALRUS_CONFIG_CXXFLAGS)
# One flag per expression keeps lists intact on CMake 2.8.12 as well.
FOREACH (_walrus_flag ${WALRUS_CXXFLAGS_DEBUG})
    LIST (APPEND WALRUS_CONFIG_CXXFLAGS "$<$<CONFIG:Debug>:${_walrus_flag}>")
ENDFOREACH()
FOREACH (_walrus_flag ${WALRUS_CXXFLAGS_MINSIZEREL})
    LIST (APPEND WALRUS_CONFIG_CXXFLAGS "$<$<CONFIG:MinSizeRel>:${_walrus_flag}>")
ENDFOREACH()
FOREACH (_walrus_flag ${WALRUS_CXXFLAGS_RELEASE})
    LIST (APPEND WALRUS_CONFIG_CXXFLAGS "$<$<AND:$<NOT:$<CONFIG:Debug>>,$<NOT:$<CONFIG:MinSizeRel>>>:${_walrus_flag}>")
ENDFOREACH()
IF (WALRUS_BUILD_SHARED_LIBS)
    SET (WALRUS_CXXFLAGS ${WALRUS_CXXFLAGS} ${WALRUS_CXXFLAGS_SHAREDLIB})
    SET (WALRUS_LDFLAGS ${WALRUS_LDFLAGS} ${WALRUS_LDFLAGS_SHAREDLIB})
ELSE()
    SET (WALRUS_CXXFLAGS ${WALRUS_CXXFLAGS} ${WALRUS_CXXFLAGS_STATICLIB})
ENDIF()

IF (WALRUS_ASAN)
    SET (WALRUS_CXXFLAGS ${WALRUS_CXXFLAGS} -fsanitize=address)
    SET (WALRUS_LDFLAGS ${WALRUS_LDFLAGS} -lasan)
ENDIF()
IF (WALRUS_GOOGLE_PERF)
    SET (WALRUS_CXXFLAGS ${WALRUS_CXXFLAGS} -DWALRUS_GOOGLE_PERF)
    SET (WALRUS_LDFLAGS ${WALRUS_LDFLAGS} -lprofiler -lunwind -llzma)
ENDIF()
IF (WALRUS_COVERAGE)
    SET (WALRUS_CXXFLAGS ${WALRUS_CXXFLAGS} -O0 -fprofile-arcs -ftest-coverage)
    SET (WALRUS_LDFLAGS ${WALRUS_LDFLAGS} --coverage)
    SET (WALRUS_LIBRARIES ${WALRUS_LIBRARIES} gcov)
ENDIF()
IF (WALRUS_JITPERF)
    SET (WALRUS_CXXFLAGS ${WALRUS_CXXFLAGS} -DWALRUS_JITPERF)
ENDIF()

# SOURCE FILES
FILE (GLOB_RECURSE WALRUS_SRC ${WALRUS_ROOT}/src/*.cpp)
LIST (REMOVE_ITEM WALRUS_SRC ${WALRUS_ROOT}/src/shell/Shell.cpp)
LIST (REMOVE_ITEM WALRUS_SRC ${WALRUS_ROOT}/src/api/wasm.cpp)

SET (WALRUS_SRC_LIST
    ${WALRUS_SRC}
)

# Dependencies must be linkable into shared Walrus libraries too.
SET (CMAKE_POSITION_INDEPENDENT_CODE ON)
SET (WALRUS_THIRDPARTY_CFLAGS ${WALRUS_THIRDPARTY_CFLAGS} ${WALRUS_CXXFLAGS_SHAREDLIB})

IF (WALRUS_GC)
    # GCUTIL
    SET (GCUTIL_CFLAGS ${WALRUS_THIRDPARTY_CFLAGS})
    IF (WALRUS_SMALL_CONFIG)
        SET (GCUTIL_CFLAGS ${GCUTIL_CFLAGS} -DSMALL_CONFIG -DMAX_HEAP_SECTS=512)
    ENDIF()
    SET (GCUTIL_BUILD_SHARED_LIBS ${WALRUS_BUILD_GC_SHARED_LIBS})
    ADD_SUBDIRECTORY (${WALRUS_ROOT}/third_party/GCutil ${CMAKE_CURRENT_BINARY_DIR}/third_party/GCutil)
    SET (WALRUS_LIBRARIES ${WALRUS_LIBRARIES} gc-lib)
    SET (WALRUS_DEFINITIONS ${WALRUS_DEFINITIONS} -DENABLE_GC)
ENDIF()

# wabt
SET (WABT_ARCH ${WALRUS_ARCH})
SET (WABT_CXX_FLAGS ${WALRUS_THIRDPARTY_CFLAGS} ${WALRUS_CONFIG_CXXFLAGS})

SET (WABT_DEFINITIONS ${WALRUS_DEFINITIONS})
SET (WITH_EXCEPTIONS TRUE)
ADD_SUBDIRECTORY (${WALRUS_ROOT}/third_party/wabt ${CMAKE_CURRENT_BINARY_DIR}/third_party/wabt)
SET (WALRUS_LIBRARIES ${WALRUS_LIBRARIES} wabt)

IF (WALRUS_WASI)
    # uvwasi and nntrainer
    IF (WALRUS_ARCH STREQUAL "x86")
        SET (UVWASI_BUILD_X86 ON)
    ENDIF()
    ADD_SUBDIRECTORY (${WALRUS_ROOT}/third_party/uvwasi ${CMAKE_CURRENT_BINARY_DIR}/third_party/uvwasi)
    LIST (APPEND WALRUS_INCDIRS ${WALRUS_THIRD_PARTY_ROOT}/uvwasi/uvwasi/src)
    SET (WALRUS_DEFINITIONS ${WALRUS_DEFINITIONS} -DENABLE_WASI)
    SET (WALRUS_LIBRARIES ${WALRUS_LIBRARIES} uvwasi_a)
    IF (WALRUS_WASI_NN AND WASI_NN_BACKEND STREQUAL "nntrainer")
        SET (WALRUS_DEFINITIONS ${WALRUS_DEFINITIONS} -DENABLE_WASI_NN)
        INCLUDE(FetchContent)
        FETCHCONTENT_DECLARE(
                nntrainer
                GIT_REPOSITORY https://github.com/nntrainer/nntrainer.git
                GIT_TAG main
        )
        FETCHCONTENT_MAKEAVAILABLE(nntrainer)

        SET (WALRUS_DEFINITIONS ${WALRUS_DEFINITIONS} -DWASINN_NNTRAINER=1)
    ENDIF()
ENDIF()

# BUILD
INCLUDE_DIRECTORIES (${WALRUS_INCDIRS})
IF (WALRUS_BUILD_SHARED_LIBS)
    ADD_LIBRARY (${WALRUS_TARGET} SHARED ${WALRUS_SRC_LIST} ${WALRUS_ROOT}/src/api/wasm.cpp)
ELSE()
    ADD_LIBRARY (${WALRUS_TARGET} STATIC ${WALRUS_SRC_LIST} ${WALRUS_ROOT}/src/api/wasm.cpp)
ENDIF()
TARGET_LINK_LIBRARIES (${WALRUS_TARGET} PRIVATE ${WALRUS_LIBRARIES} ${WALRUS_LDFLAGS} ${LDFLAGS_FROM_ENV})
IF (WALRUS_BUILD_SHARED_LIBS AND WALRUS_HOST STREQUAL "android")
    TARGET_LINK_LIBRARIES (${WALRUS_TARGET} PRIVATE -shared)
ENDIF()
TARGET_INCLUDE_DIRECTORIES (${WALRUS_TARGET} PUBLIC ${WALRUS_ROOT}/src/api/)
TARGET_COMPILE_DEFINITIONS (${WALRUS_TARGET} PRIVATE ${WALRUS_DEFINITIONS})
TARGET_COMPILE_OPTIONS (${WALRUS_TARGET} PRIVATE ${WALRUS_CONFIG_CXXFLAGS} ${WALRUS_CXXFLAGS} ${CXXFLAGS_FROM_ENV})

IF (WALRUS_ENABLE_SHELL)
    # The shell uses internal C++ APIs, which the wasm-c-api shared library
    # deliberately hides. Reuse the core sources for a shared-library build.
    IF (WALRUS_BUILD_SHARED_LIBS)
        ADD_EXECUTABLE (walrus_shell ${WALRUS_SRC_LIST} ${WALRUS_ROOT}/src/shell/Shell.cpp)
        TARGET_LINK_LIBRARIES (walrus_shell PRIVATE ${WALRUS_LIBRARIES} ${WALRUS_LDFLAGS} ${LDFLAGS_FROM_ENV})
    ELSE()
        ADD_EXECUTABLE (walrus_shell ${WALRUS_ROOT}/src/shell/Shell.cpp)
        TARGET_LINK_LIBRARIES (walrus_shell PRIVATE ${WALRUS_TARGET})
    ENDIF()
    SET_TARGET_PROPERTIES (walrus_shell PROPERTIES OUTPUT_NAME walrus)
    # Avoid colliding with walrus.lib (the DLL import library) on Windows.
    IF (WIN32)
        SET_TARGET_PROPERTIES (walrus_shell PROPERTIES ARCHIVE_OUTPUT_NAME walrus_shell)
    ENDIF()
    TARGET_LINK_LIBRARIES (walrus_shell PRIVATE ${WALRUS_LIBRARIES})
    IF (WALRUS_SHELL_LDFLAGS)
        # Slash-prefixed MSVC options are treated as paths by TARGET_LINK_LIBRARIES.
        SET_PROPERTY (TARGET walrus_shell APPEND_STRING PROPERTY LINK_FLAGS " ${WALRUS_SHELL_LDFLAGS}")
    ENDIF()
    TARGET_INCLUDE_DIRECTORIES (walrus_shell PRIVATE ${WALRUS_ROOT}/third_party/wabt/include ${CMAKE_CURRENT_BINARY_DIR}/third_party/wabt/include)
    TARGET_COMPILE_DEFINITIONS (walrus_shell PRIVATE ${WALRUS_DEFINITIONS})
    TARGET_COMPILE_OPTIONS (walrus_shell PRIVATE ${WALRUS_CONFIG_CXXFLAGS} ${WALRUS_CXXFLAGS} ${WALRUS_CXXFLAGS_SHELL} ${CXXFLAGS_FROM_ENV} ${PROFILER_FLAGS})
    IF (WALRUS_WASI_NN AND WASI_NN_BACKEND STREQUAL "nntrainer")
        TARGET_INCLUDE_DIRECTORIES (walrus_shell PRIVATE ${nntrainer_SOURCE_DIR}/api/ ${nntrainer_SOURCE_DIR}/api/ccapi/include/)
        TARGET_LINK_LIBRARIES (walrus_shell PRIVATE ${WALRUS_THIRD_PARTY_ROOT}/nntrainer/libnntrainer.so ${WALRUS_THIRD_PARTY_ROOT}/nntrainer/libccapi-nntrainer.so)
    ENDIF()
ENDIF()

IF (WALRUS_BUILD_API_TESTS)
    function(c_api_example NAME)
        set(EXENAME wasm-c-api-${NAME})
        add_executable(${EXENAME} ${WALRUS_THIRD_PARTY_ROOT}/wasm-c-api/example/${NAME}.c)
        if (COMPILER_IS_MSVC)
            set_target_properties(${EXENAME} PROPERTIES COMPILE_FLAGS "-wd4311")
        else ()
            set_target_properties(${EXENAME} PROPERTIES COMPILE_FLAGS "-std=gnu11 -Wno-pointer-to-int-cast -g3")
        endif ()

        target_link_libraries(${EXENAME} ${WALRUS_TARGET})
    endfunction()

    c_api_example(callback)
#c_api_example(finalize)
    c_api_example(global)
    c_api_example(hello)
#c_api_example(hostref)
    c_api_example(multi)
    c_api_example(memory)
    c_api_example(reflect)
#c_api_example(serialize)
#c_api_example(start)
    c_api_example(table)
#c_api_example(trap)
#c_api_example(threads)
ENDIF()
